# Node.js backend port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecoscan?retryWrites=true&w=majority

# JWT signing secret — use a strong random value in production
JWT_SECRET=your_strong_secret_here

# URL of the Python Flask AI service (YOLO11 inference).
# Local development:  http://127.0.0.1:8000
# Production:         http://<ai-service-host>:<port>
AI_SERVICE_URL=http://127.0.0.1:8000
